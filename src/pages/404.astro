---
// 404 — 잘못된 주소로 들어와도 막다른 길이 되지 않도록 전체 서식으로 되돌아갈 길을 제공합니다.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteMenu from "../components/SiteMenu.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { navCategories, navHref } from "../data/nav";

const meta = {
  title: "페이지를 찾을 수 없습니다 | DocLabel",
  description: "요청하신 페이지를 찾을 수 없습니다. 전체 서식 목록에서 필요한 문서 서식을 찾아보세요.",
  slug: "404",
  noindex: true,
};
---

<BaseLayout meta={meta}>
  <div class="simple-app hub-app">
    <header class="top-toolbar screen-only">
      <SiteMenu />
      <div class="toolbar-title">페이지를 찾을 수 없음</div>
      <span class="toolbar-spacer" aria-hidden="true"></span>
    </header>

    <main class="hub-page">
      <section class="hub-hero">
        <h1>페이지를 찾을 수 없습니다</h1>
        <p>
          주소가 바뀌었거나 삭제된 페이지일 수 있습니다. 아래에서 필요한 서식을 바로 찾아가거나,
          <a href="/forms/">전체 서식 목록</a>에서 확인해 보세요.
        </p>
      </section>

      {
        navCategories.map((category) => (
          <section class="hub-section">
            <h2>{category.name}</h2>
            <ul class="hub-grid">
              {category.items.map((item) => (
                <li>
                  <div class="hub-card">
                    <a class="hub-card-main" href={navHref(item.slug)}>
                      <strong>{item.name}</strong>
                      <span>{item.desc}</span>
                    </a>
                    {item.children && (
                      <ul class="hub-sub">
                        {item.children.map((child) => (
                          <li>
                            <a href={navHref(child.slug)}>{child.name}</a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
