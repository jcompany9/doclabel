---
// 전체 서식 허브 — 서식 미리보기 썸네일로 고르는 랜딩 페이지.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteMenu from "../../components/SiteMenu.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { navCategories, navHref, navFormCount, thumbFor } from "../../data/nav";

const total = navFormCount;

const meta = {
  title: "무료 문서 서식 모음 | 근로계약서·재직증명서·위임장·견적서 온라인 작성 | DocLabel",
  description: `근로계약서, 재직증명서, 이력서, 사직서, 위임장, 견적서, 거래명세서 등 자주 쓰는 문서 서식 ${total}종을 설치·회원가입 없이 브라우저에서 바로 작성하고 A4로 인쇄하세요.`,
  slug: "forms",
  keywords: ["문서 서식", "무료 서식", "양식 모음", "서식 온라인 작성", "무료 양식"],
};

const stats = [
  { value: `${total}종`, label: "바로 쓰는 문서 서식" },
  { value: "0원", label: "가입도 설치도 없음" },
  { value: "A4", label: "그대로 인쇄·PDF 저장" },
];
---

<BaseLayout meta={meta}>
  <div class="hub-shell">
    <header class="top-toolbar screen-only">
      <SiteMenu />
      <div class="toolbar-title">전체 서식</div>
      <a class="print-button toolbar-cta" href="#서식-고르기">서식 고르기</a>
    </header>

    <main>
      <section class="lp-hero">
        <div class="lp-hero-text">
          <h1>필요한 문서 서식,<br />지금 바로 작성하세요</h1>
          <p>
            근로계약서·이력서·위임장·견적서까지 {total}종. 프로그램 설치도 회원가입도 없이
            브라우저에서 칸을 채우고 A4로 인쇄하면 끝입니다.
          </p>
          <div class="lp-cta">
            <a class="lp-btn lp-btn-primary" href="#서식-고르기">서식 고르기</a>
            <a class="lp-btn lp-btn-ghost" href="/employment-contract/">근로계약서 바로 쓰기 →</a>
          </div>
          <p class="lp-note">입력한 내용은 서버로 전송되지 않고 내 브라우저 안에서만 처리됩니다.</p>
        </div>

        <div class="lp-hero-art" aria-hidden="true">
          <img src={thumbFor("employment-contract")} alt="" width="420" height="594" />
          <img src={thumbFor("resume")} alt="" width="420" height="594" />
        </div>
      </section>

      <section class="lp-stats">
        {
          stats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))
        }
      </section>

      <div id="서식-고르기" class="lp-forms">
        {
          navCategories.map((category) => (
            <section class="lp-section">
              <h2>{category.name}</h2>
              <ul class="lp-grid">
                {category.items.map((item) => (
                  <li>
                    <div class="lp-card">
                      <a class="lp-card-main" href={navHref(item.slug)}>
                        <span class="lp-thumb">
                          <img
                            src={thumbFor(item.slug)}
                            alt={`${item.name} 미리보기`}
                            width="420"
                            height="594"
                            loading="lazy"
                          />
                        </span>
                        <strong>{item.name}</strong>
                        <span class="lp-desc">{item.desc}</span>
                      </a>
                      {item.children && (
                        <ul class="hub-sub">
                          {item.children.map((child) => (
                            <li>
                              <a href={navHref(child.slug)}>{child.name}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
