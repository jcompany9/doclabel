---
import { site } from "../data/site";

interface Props {
  slot?: string; // AdSense 광고 단위 슬롯 ID
}

const { slot = "" } = Astro.props;
// 게시자 ID와 광고 단위 슬롯 ID가 모두 있을 때만 렌더합니다.
// 슬롯 없이 빈 광고 자리를 두면 관련 서식 링크 목록 옆의 탐색 요소처럼 보일 수 있어 정책상 피합니다.
const enabled = Boolean(site.adsenseClient && slot);
---

{
  enabled && (
    <aside class="ad-slot screen-only" aria-label="광고">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={site.adsenseClient}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}
