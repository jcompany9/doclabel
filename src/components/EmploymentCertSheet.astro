---
// 재직증명서 전용 A4 문서 시트 + 상단 도구막대.
import FieldToolbar from "./FieldToolbar.astro";
---

<header class="top-toolbar screen-only">
  <a class="toolbar-home" href="/">← DocLabel</a>
  <div class="toolbar-title">재직증명서</div>
  <button class="print-button" type="button" data-action="print" aria-label="인쇄하기">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 3h10v4H7V3zm10 14v4H7v-4h10zm2-8H5a2 2 0 0 0-2 2v5h4v-3h10v3h4v-5a2 2 0 0 0-2-2zm-3 3H8V9h8v3z" />
    </svg>
    <span>인쇄</span>
  </button>
</header>

<main class="page-body">
  <FieldToolbar />

  <section class="paper-wrap">
    <article class="paper template-employment-cert" id="printSheet" data-template="single">
      <div class="cert-title">재 직 증 명 서</div>

      <table class="cert-table">
        <tbody>
          <tr>
            <th>성명</th>
            <td><div class="sheet-edit cert-input" data-field="name" data-placeholder="홍길동" contenteditable="plaintext-only" spellcheck="false"></div></td>
            <th>생년월일</th>
            <td class="cert-datecell">
              <div class="sheet-edit cert-input" data-field="birthDate" data-placeholder="1990.01.01" contenteditable="plaintext-only" spellcheck="false"></div>
              <span class="date-tools screen-only">
                <button type="button" class="date-pick" data-target="birthDate" aria-label="생년월일 선택">📅</button>
              </span>
              <input type="date" class="date-input-hidden" data-target="birthDate" data-format="dot" tabindex="-1" aria-hidden="true" />
            </td>
          </tr>
          <tr>
            <th>주소</th>
            <td colspan="3"><div class="sheet-edit cert-input" data-field="address" data-placeholder="서울특별시 ..." contenteditable="plaintext-only" spellcheck="false"></div></td>
          </tr>
          <tr>
            <th>부서</th>
            <td><div class="sheet-edit cert-input" data-field="department" data-placeholder="경영지원팀" contenteditable="plaintext-only" spellcheck="false"></div></td>
            <th>직위</th>
            <td><div class="sheet-edit cert-input" data-field="position" data-placeholder="과장" contenteditable="plaintext-only" spellcheck="false"></div></td>
          </tr>
          <tr>
            <th>재직기간</th>
            <td colspan="3" class="cert-datecell">
              <div class="sheet-edit cert-input" data-field="employmentPeriod" data-placeholder="2020.03.02 ~ 현재" contenteditable="plaintext-only" spellcheck="false"></div>
              <span class="date-tools screen-only">
                <button type="button" class="date-pick" data-target="employmentPeriod" data-range="start" aria-label="입사일 선택">📅 입사일</button>
                <button type="button" class="date-pick" data-target="employmentPeriod" data-range="end" aria-label="종료일 선택">📅 종료일</button>
              </span>
              <input type="date" class="date-input-hidden" data-target="employmentPeriod" data-range="start" tabindex="-1" aria-hidden="true" />
              <input type="date" class="date-input-hidden" data-target="employmentPeriod" data-range="end" tabindex="-1" aria-hidden="true" />
            </td>
          </tr>
          <tr>
            <th>담당업무</th>
            <td colspan="3"><div class="sheet-edit cert-input" data-field="duties" data-placeholder="총무 및 인사 업무" contenteditable="plaintext-only" spellcheck="false"></div></td>
          </tr>
          <tr>
            <th>용도</th>
            <td colspan="3"><div class="sheet-edit cert-input" data-field="purpose" data-placeholder="제출처 / 사용 용도" contenteditable="plaintext-only" spellcheck="false"></div></td>
          </tr>
        </tbody>
      </table>

      <p class="cert-statement">위 사람은 위와 같이 본 회사에 재직하고 있음을 증명합니다.</p>

      <div class="cert-date cert-datecell">
        <div class="sheet-edit cert-date-input" data-field="issueDate" data-placeholder="2026년 00월 00일" contenteditable="plaintext-only" spellcheck="false"></div>
        <span class="date-tools screen-only">
          <button type="button" class="date-pick" data-target="issueDate" aria-label="작성 날짜 선택">📅</button>
        </span>
        <input type="date" class="date-input-hidden" data-target="issueDate" data-format="korean" tabindex="-1" aria-hidden="true" />
      </div>

      <div class="cert-issuer">
        <div class="cert-issuer-line">
          <span class="lab">회사명</span>
          <div class="sheet-edit cert-input" data-field="companyName" data-placeholder="(주)회사이름" contenteditable="plaintext-only" spellcheck="false"></div>
        </div>
        <div class="cert-issuer-line">
          <span class="lab">주소</span>
          <div class="sheet-edit cert-input" data-field="companyAddress" data-placeholder="회사 주소" contenteditable="plaintext-only" spellcheck="false"></div>
        </div>
        <div class="cert-issuer-line cert-ceo">
          <span class="lab">대표자</span>
          <div class="sheet-edit cert-input" data-field="ceoName" data-placeholder="대표자 성명" contenteditable="plaintext-only" spellcheck="false"></div>
          <span class="cert-seal" data-seal title="클릭해서 인감(직인) 이미지를 올리세요">
            <img class="seal-img" alt="직인 이미지" />
            <span class="seal-label">(직인)</span>
            <button type="button" class="seal-remove screen-only" aria-label="직인 이미지 삭제">✕</button>
            <input type="file" class="seal-file" accept="image/*" hidden />
          </span>
        </div>
      </div>
    </article>
  </section>
</main>
