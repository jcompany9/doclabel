---
// 상단 리본 — 엑셀·워드처럼 글꼴/크기/자간/굵게를 헤더 아래 한 줄에 둡니다.
// editor.js 가 #fieldToolbar 및 각 컨트롤 ID 를 그대로 참조하므로 ID 는 바꾸지 않습니다.
---

<div id="fieldToolbar" class="ribbon screen-only">
  <div class="ribbon-inner">
    <div class="ribbon-group">
      <span class="ribbon-label">글꼴</span>
      <select id="fontFamilySelect" class="ribbon-select">
        <option value="'Pretendard', sans-serif">Pretendard</option>
        <option value="'Gowun Batang', serif">고운바탕</option>
        <option value="'Black Han Sans', sans-serif">검은고딕</option>
        <option value="'Noto Serif KR', serif">본명조</option>
      </select>
    </div>

    <span class="ribbon-sep" aria-hidden="true"></span>

    <div class="ribbon-group">
      <span class="ribbon-label">크기</span>
      <input id="fontSizeInput" class="ribbon-num" type="number" min="8" max="120" step="1" value="42" />
    </div>

    <div class="ribbon-group">
      <span class="ribbon-label">자간</span>
      <input id="letterSpacingInput" class="ribbon-num" type="number" min="-10" max="40" step="0.5" value="8" />
    </div>

    <span class="ribbon-sep" aria-hidden="true"></span>

    <label class="ribbon-toggle" title="굵게">
      <input id="boldToggle" type="checkbox" />
      <span>가</span>
    </label>

    <span class="ribbon-hint">칸을 클릭하면 그 칸의 글자를 바꿀 수 있습니다.</span>
  </div>
</div>
